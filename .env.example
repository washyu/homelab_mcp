# Homelab MCP Server Configuration
# Copy this file to .env and update with your values:
#   cp .env.example .env
#
# See docs/configuration.md for detailed descriptions of all options.

# =============================================================================
# Proxmox Connection (required)
# =============================================================================

PROXMOX_HOST=192.168.10.200

# Option 1: Password authentication (2-hour ticket timeout)
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=your_password_here

# Option 2: API token authentication (no timeout, recommended)
# Create token in Proxmox UI: Datacenter -> Permissions -> API Tokens
# Format: user@realm!tokenid=uuid
# PROXMOX_API_TOKEN=root@pam!mcp-server=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Set to false if Proxmox uses a self-signed certificate
# PROXMOX_VERIFY_SSL=true

# Path to custom CA certificate for Proxmox
# PROXMOX_CA_CERT=/path/to/proxmox-ca.crt

# =============================================================================
# Server
# =============================================================================

# MCP_DEBUG=false
# MCP_LOG_LEVEL=INFO

# =============================================================================
# SSH
# =============================================================================

# SSH_TIMEOUT=10
# SSH_RETRIES=3

# =============================================================================
# Discovery
# =============================================================================

# DISCOVERY_BATCH_SIZE=10
# DISCOVERY_TIMEOUT=300

# =============================================================================
# HTTP Transport
# =============================================================================

# MCP_HTTP_ENABLED=false
# MCP_HTTP_HOST=0.0.0.0
# MCP_HTTP_PORT=8080
# MCP_AUTH_ENABLED=true

# Generate an API key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_API_KEY=

# SSL for HTTPS (optional)
# MCP_SSL_CERT=/path/to/cert.pem
# MCP_SSL_KEY=/path/to/key.pem

# =============================================================================
# Database
# =============================================================================

# DATABASE_TYPE=sqlite
# SQLITE_PATH=~/.mcp/sitemap.db

# PostgreSQL (requires ENABLE_POSTGRESQL=true and psycopg2-binary)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=homelab_mcp
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password

# =============================================================================
# Feature Flags
# =============================================================================

# ENABLE_POSTGRESQL=false
# ENABLE_RESOURCE_POOLS=false
